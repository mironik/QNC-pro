{
  "template_id": "news_package",
  "name": "News package",
  "description": "Uravnotežen rad: kartica se kopira, Ingest bira klipove; proxy u projektu za slabija računala; XDCAM 50i predaja.",
  "modes": ["story"],
  "settings": {
    "workflow": "news_package",
    "input": { "mode": "auto" },
    "playback": { "input": "proxy", "cache": { "mode": "off" } },
    "video": {
      "format": "HD 1080i50", "width": 1920, "height": 1080, "fps": 25,
      "field_order": "upper_first", "color_space": "rec709", "timeline_codec": "xdcam_hd_422"
    },
    "storage": {
      "projects_root": "", "ingest_profile": "field", "ingest_media": "proxy",
      "proxy_policy": "copy_to_project", "original_policy": "link_when_available"
    },
    "export": {
      "lead_in_seconds": 2, "start_timecode": "10:00:00:00", "video_bitrate_mbps": 35, "tail_seconds": 2,
      "directory": "exports/projekti", "default_mode": "xml_master", "preset": "xdcam_hd422_50i",
      "format": "HD 1080i50", "fps": 25, "width": 1920, "height": 1080, "field_order": "upper_first",
      "color_space": "rec709", "container": "mxf_op1a", "video_codec": "mpeg2_422_50mbit",
      "audio_sample_rate": 48000, "audio_channels": 2, "custom_presets": [], "xml_enabled": true
    },
    "audio": {
      "sample_rate": 48000, "channels": 2, "crossfade_frames": 4, "reading_words_per_second": 2.5,
      "loudness": { "a1_lufs": -23, "a2_lufs": -23, "true_peak_dbtp": -1, "tolerance_lu": 0.5 },
      "transcribe_channel": "CH1", "atmosphere_channel": "CH2"
    },
    "ai": { "template": "none", "features": [], "language": "hr" },
    "artifacts": { "filmstrip": "auto", "wave": "auto" },
    "keyboard_shortcuts": { "active_preset": "default" }
  }
}
